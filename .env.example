# Copy to `.env` in same directory as docker-compose.yml (do not commit real secrets).

# Postgres
POSTGRES_DB=studysmart
POSTGRES_USER=studysmart
POSTGRES_PASSWORD=studysmart

# Spring Boot → configured via compose environment
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/studysmart?sslmode=disable

# JWT (change in prod)
JWT_SECRET=change-this-to-at-least-256-bits-long-secret-key-for-development-only

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# AI integration (Spring)
AI_SERVICE_BASE_URL=http://ai-service:8001
AI_ENABLED=true

# Python AI service → Ollama
OLLAMA_BASE_URL=http://ollama:11434
# Browser → API when using composed nginx build (must reach host-mapped backend)
VITE_API_BASE_URL=http://localhost:8080
